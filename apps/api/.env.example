# Runtime environment: development | test | production
NODE_ENV="development"

# TCP port the API listens on.
PORT=3000

# Prefix applied to every route, e.g. GET /api/health.
API_PREFIX="api"

# Connection string for the Gymly PostgreSQL database.
# Copied to .env (which is gitignored) and adjusted per environment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gymly?schema=public"

# Separate database used by the integration tests, which TRUNCATE both tables.
# Must not be the same database as DATABASE_URL.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gymly_test?schema=public"

# Comma-separated list of browser origins allowed by CORS.
# Must match where the Next.js app is served. Default: http://localhost:8000
FRONTEND_URL="http://localhost:8000"

# Send cookies/credentials cross-origin. Keep false unless the frontend needs it.
CORS_CREDENTIALS="true"

# Secret used to sign authentication tokens. REQUIRED, with no default.
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
# Never commit a real value and never reuse a key across environments.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

# Access token lifetime: a number of seconds, or a duration like 15m / 1h / 7d.
JWT_EXPIRES_IN="15m"
